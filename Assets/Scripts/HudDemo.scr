
// Hand-written demo for the game HUD (Core.GameHud): hotbar slots, health/energy bars, counters.
// Spawn Entities/Debug/hudDemo.pre to see it; keys 1..9,0 select hotbar slots and fire "Hotbar Select".

SCRIPT_EXPORT void OnSpawn(const ScriptContext* ctx, Entity* self, void* scriptData)
{
    ctx->hudSetSlot(0, "Sword", 0);
    ctx->hudSetSlot(1, "Bow", 0);
    ctx->hudSetSlot(2, "Arrow", 64);
    ctx->hudSetSlot(3, "Apple", 5);
    ctx->hudSetSlot(4, "Torch", 12);
    ctx->hudSelectSlot(0);
    ctx->hudSetBar("Health", 100.0f, 100.0f, glm::vec3(0.85f, 0.15f, 0.15f));
    ctx->hudSetBar("Energy", 100.0f, 100.0f, glm::vec3(0.15f, 0.55f, 0.9f));
    ctx->hudSetCounter("Coins", 128.0f, 0, glm::vec3(1.0f, 0.85f, 0.2f));
    ctx->log("HUD demo: keys 1..9,0 select hotbar slots (fires the 'Hotbar Select' event)");
}

SCRIPT_EXPORT void Update(const ScriptContext* ctx, Entity* self, float dt, void* scriptData)
{
    const float t = ctx->elapsedSeconds;
    ctx->hudSetBar("Health", 50.0f + 50.0f * sinf(t * 0.5f), 100.0f, glm::vec3(0.85f, 0.15f, 0.15f));
    ctx->hudSetBar("Energy", 50.0f + 50.0f * sinf(t * 1.7f + 2.0f), 100.0f, glm::vec3(0.15f, 0.55f, 0.9f));
    ctx->hudSetCounter("Time", t, 1, glm::vec3(0.9f, 0.9f, 0.9f));
}

SCRIPT_EXPORT void OnDestroy(const ScriptContext* ctx, Entity* self, void* scriptData)
{
    ctx->hudClear(0);
}

SCRIPT_EXPORT void OnEvent(const ScriptContext* ctx, Entity* self, int eventIdx, void* scriptData)
{
    if (eventIdx == 0)
        ctx->hudSetCounter("Selected slot", (float)(ctx->hudGetSelectedSlot(0) + 1), 0, glm::vec3(0.6f, 1.0f, 0.6f));
}

SCRIPT_EXPORT int ScriptEventCount(void) { return 1; }
SCRIPT_EXPORT const char* ScriptEventName(int eventIdx)
{
    switch (eventIdx)
    {
    case 0: return "Hotbar Select";
    default: return "";
    }
}

REGISTER_ON_SPAWN()
REGISTER_UPDATE()
REGISTER_ON_DESTROY()
REGISTER_ON_EVENT()
