// Demo for the Light component: one entity carrying all four light types at once, with the
// debug wireframes on. Offsets/directions are entity space, so moving or rotating the entity
// (gizmo, script, parent) carries the whole rig.
Prefab lightRig
	Position 0 0 0
	Rotation 0 -0 0
	Scale 1
	Component Light
		Debug true
		Light Point
			Offset 0, 1, 0
			Color 1, 0.85, 0.6
			Intensity 40
			Range 12
		Light Spot
			Offset 0, 3, 0
			Direction 0, -1, 0
			Color 0.7, 0.85, 1
			Intensity 60
			Range 15
			ConeAngle 30
			EdgeSoftness 0.25
		Light Area
			Offset -2, 1.5, 0
			Direction 1, 0, 0
			Color 1, 1, 1
			Intensity 15
			Range 10
			Width 1.5
			Height 1
		Light Tube
			Offset 2, 1.5, 0
			Direction 0, 0, 1
			Color 1, 0.6, 0.4
			Intensity 20
			Range 8
			Radius 0.1
			Length 2
