// The character visual riding the player capsule (playerCapsule.pre / netPlayerCapsule.pre spawn it
// as a child): skinned humanoid + CharacterAnimator, animated and yawed by Scripts/PlayerBody.scr
// from the parent capsule's actual movement. No physics, no network — the capsule owns both.
Prefab playerBody
	Component Render
		ObjectContainer character
		Node ROOT
		Type SkinnedMesh
			Rig Humanoid
		Scale 0.005
	Component Animator
		Animator CharacterAnimator
	Component Script
		Path Scripts/PlayerBody.dsl
		Enabled true
