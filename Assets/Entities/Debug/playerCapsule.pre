Prefab playerCapsule
	Position 0 0 0
	Rotation 0 0 0
	Scale 0.4
	Component Scene
		// Character visual at the capsule bottom; Scale 2.5 cancels the root's 0.4 so the model
		// keeps its authored size. Animated/yawed from the capsule's movement by PlayerBody.scr.
		Prefab playerBody
			Position 0 -2 0
			Scale 2.5
	Component Render
		ObjectContainer wireshapes
		Node Capsule
		Type StaticMesh
	Component Physics
		Body Dynamic
		Shape Capsule
		Radius 1
		HalfHeight 1
		Density 120
		Friction 0.3
		Restitution 0
		LockRotation true
